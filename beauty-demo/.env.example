# Optional; the server reads process environment, not this file automatically.
PORT=3090
DATABASE_PATH=./data/beauty.sqlite
# Set these in the terminal that launches the HTTP backend to enable real models.
# Without keys, explicit risk/handoff still work; ordinary consultation is degraded.
# TYPESAFE_API_KEY=your-typesafe-key
# CHAT_API_KEY=your-chat-provider-key
# CHAT_BASE_URL=https://api.deepseek.com/v1
# CHAT_MODEL=an-available-model-in-your-account
# BUSINESS_CONFIG=./config/business.demo.json
# BEAUTY_LOCAL_CONFIG=./config/local.json
# CHAT_THINKING=disabled
# Optional MCP configuration (Harness passes these explicitly to the child).
BEAUTY_API_URL=http://127.0.0.1:3090
BEAUTY_USER_ID=demo-user-a
BEAUTY_API_TIMEOUT_MS=10000
# Optional operator login password (12+ chars). Otherwise generated in data/operator-password.txt.
# BEAUTY_OPERATOR_PASSWORD=your-own-private-operator-password
# Optional when behind a trusted loopback HTTPS reverse proxy:
# BEAUTY_TRUST_PROXY=1
# MCP client only; provision with npm run mcp:token:
# BEAUTY_API_TOKEN_FILE=./data/mcp-credentials-demo-user-a.json
